# =============================================================================
# OpenWA — VPS + Neon production template
# =============================================================================
# 1. Copy to .env on your VPS:  cp .env.production.example .env
# 2. Rotate Neon password in Neon Console before filling secrets below
# 3. chmod 600 .env
# 4. First boot: DATABASE_HOST = direct Neon host (no -pooler)
# 5. After migrations: switch DATABASE_HOST to pooler host (-pooler in hostname)

NODE_ENV=production
API_PORT=2785
DASHBOARD_PORT=2886
LOG_LEVEL=info
BIND_ADDRESS=0.0.0.0

DOMAIN=your-domain.com
BASE_URL=https://your-domain.com
DASHBOARD_URL=https://your-domain.com
CORS_ORIGINS=https://your-domain.com

DASHBOARD_ENABLED=true
PROXY_ENABLED=true

API_MASTER_KEY=generate-a-long-random-key-here
JWT_SECRET=generate-a-long-random-jwt-secret-here
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com
BOOTSTRAP_ADMIN_PASSWORD=choose-a-strong-password
ENABLE_SWAGGER=false

ENGINE_TYPE=whatsapp-web.js
PUPPETEER_HEADLESS=true
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu
SESSION_DATA_PATH=./data/sessions
# Mixed engines (some sessions on wwjs + some on Baileys): use OPENWA_API_MEMORY_LIMIT=3g and PUPPETEER_SHM_SIZE=512mb in docker-compose
AUTO_START_SESSIONS=true
SESSION_MAX_RECONNECT_ATTEMPTS=50
SESSION_CONNECT_RECONNECT_ATTEMPTS=30
SESSION_RECONNECT_BASE_DELAY_MS=5000
SESSION_RECONNECT_INFINITE=true
SESSION_RECONNECT_MAX_DELAY_MS=300000
SESSION_HEALTH_MONITOR_ENABLED=true
SESSION_HEALTH_MONITOR_INTERVAL_MS=60000
SESSION_HEALTH_AUTO_RESTART=true
SESSION_SCHEDULED_RESTART_ENABLED=true
SESSION_SCHEDULED_RESTART_DAY=0
SESSION_SCHEDULED_RESTART_TIME=03:00

DATABASE_TYPE=postgres
POSTGRES_BUILTIN=false
DATABASE_HOST=ep-xxxx.us-east-1.aws.neon.tech
DATABASE_PORT=5432
DATABASE_NAME=openwa
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=your-rotated-neon-password
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false
DATABASE_POOL_SIZE=10

REDIS_ENABLED=false
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/media

PLUGINS_ENABLED=true
