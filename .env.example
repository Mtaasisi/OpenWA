# =============================================================================
# OpenWA - Environment Configuration
# =============================================================================
# Copy this file to .env and customize as needed.
# This is the Single Source of Truth for all configuration.

# =============================================================================
# CORE SETTINGS
# =============================================================================
NODE_ENV=production
API_PORT=2785
LOG_LEVEL=info                      # error | warn | info | debug

# Domain Configuration
DOMAIN=localhost
DASHBOARD_PORT=2886

# Public URLs (for startup banner and external access)
# BASE_URL=https://api.yourdomain.com
# DASHBOARD_URL=https://dashboard.yourdomain.com

# CORS Configuration (comma-separated origins; * crashes in NODE_ENV=production unless ALLOW_OPEN_CORS=true)
CORS_ORIGINS=*

# Docker bind address for public VPS access (127.0.0.1 for local-only, 0.0.0.0 for internet)
BIND_ADDRESS=0.0.0.0

# SSL/TLS (enable for production with real domain)
# TRAEFIK_ACME_EMAIL=admin@yourdomain.com
# TRAEFIK_ACME_STORAGE=/letsencrypt/acme.json

# =============================================================================
# COMPONENTS (enable/disable container profiles)
# =============================================================================
DASHBOARD_ENABLED=true              # Enable dashboard container
PROXY_ENABLED=true                  # Enable Traefik proxy container

# =============================================================================
# ENGINE CONFIGURATION
# =============================================================================
# Which WhatsApp engine to use (plugin-based)
# Options: whatsapp-web.js, baileys
# Baileys stores auth in SESSION_DATA_PATH/baileys/{sessionId} (re-scan QR when switching engines)
ENGINE_TYPE=whatsapp-web.js

# Engine-specific settings
SESSION_DATA_PATH=./data/sessions
PUPPETEER_HEADLESS=true
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu
# Docker mixed wwjs + Baileys (per-session overrides): see docker-compose openwa-api mem_limit / shm_size
# OPENWA_API_MEMORY_LIMIT=3g
# PUPPETEER_SHM_SIZE=512mb

# QR scan / connect UX (optional)
WA_SESSION_READY_TIMEOUT_MS=0
WA_SLOW_CONNECT_NOTICE_MS=60000
# Background sync throttling for large chat accounts (after ready)
WA_BACKGROUND_SYNC_DELAY_MS=60000
WA_BACKGROUND_CHAT_BATCH_SIZE=20
WA_BACKGROUND_CHAT_BATCH_DELAY_MS=30000
WA_BACKGROUND_PROFILE_DELAY_MS=2000
WA_MEDIA_BACKFILL_DELAY_MS=500
WA_HISTORY_BACKFILL_MESSAGES=40
WA_HISTORY_BACKFILL_DELAY_MS=3000
# Large inbox: skip full engine.listChats() when thread count exceeds threshold
WA_LARGE_ACCOUNT_THRESHOLD=2000
WA_INBOX_QUEUE_COUNTS_CACHE_MS=60000
WA_INBOX_DEFAULT_ACTIVE_SINCE_DAYS=90
WA_LARGE_ACCOUNT_COUNTS_SAMPLE=500
WA_LARGE_ACCOUNT_SYNC_MAX_CHATS=200
WA_LARGE_ACCOUNT_HOT_TIER_DAYS=30
WA_LARGE_ACCOUNT_HOT_TIER_SIZE=500
WA_LARGE_ACCOUNT_COLD_RESOLVED_DAYS=180
WA_SYNC_WINDOW_MS=300000

# Session lifecycle (reconnect after transient disconnects; auto-start linked sessions on boot)
AUTO_START_SESSIONS=true
SESSION_MAX_RECONNECT_ATTEMPTS=50
SESSION_CONNECT_RECONNECT_ATTEMPTS=30
SESSION_RECONNECT_BASE_DELAY_MS=5000
SESSION_RECONNECT_INFINITE=true
SESSION_RECONNECT_MAX_DELAY_MS=300000
SESSION_HEALTH_MONITOR_ENABLED=true
SESSION_HEALTH_MONITOR_INTERVAL_MS=60000
SESSION_HEALTH_AUTO_RESTART=true
# Optional weekly soft restart for long-running sessions (Sunday 03:00 server time)
SESSION_SCHEDULED_RESTART_ENABLED=false
SESSION_SCHEDULED_RESTART_DAY=0
SESSION_SCHEDULED_RESTART_TIME=03:00

# WhatsApp Safety — optional Meta Cloud API template sync + outbound sends (Settings → WhatsApp Safety → Templates)
# WHATSAPP_CLOUD_ACCESS_TOKEN=your-long-lived-system-user-token
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=your-meta-phone-number-id
# WHATSAPP_CLOUD_SYNC_INTERVAL_HOURS=24
# WHATSAPP_QUEUE_POLL_MS=5000

# =============================================================================
# DATABASE
# =============================================================================
# Options: sqlite, postgres
DATABASE_TYPE=sqlite
POSTGRES_BUILTIN=false              # Use built-in PostgreSQL container?

# PostgreSQL settings (ignored for sqlite, auto-configured if POSTGRES_BUILTIN=true)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=openwa
DATABASE_USERNAME=openwa
DATABASE_PASSWORD=your-secure-password
DATABASE_SYNCHRONIZE=false          # WARNING: Set false in production!
DATABASE_LOGGING=false
DATABASE_POOL_SIZE=10
# Required for Neon / managed Postgres (sslmode=require)
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# --- Neon PostgreSQL (external, recommended for VPS production) ---
# First boot: use DIRECT host (no -pooler) so migrations succeed, then switch to pooler.
# DATABASE_TYPE=postgres
# POSTGRES_BUILTIN=false
# DATABASE_HOST=ep-xxxx.us-east-1.aws.neon.tech
# DATABASE_PORT=5432
# DATABASE_NAME=openwa
# DATABASE_USERNAME=neondb_owner
# DATABASE_PASSWORD=rotate-in-neon-console
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Enable pgvector in Neon Console (or: ./scripts/neon-enable-pgvector.sh)

# =============================================================================
# REDIS / QUEUE (Phase 2)
# =============================================================================
REDIS_ENABLED=false                 # Enable Redis for queue and caching
REDIS_BUILTIN=false                 # Use built-in Redis container?

# Redis settings (auto-configured if REDIS_BUILTIN=true)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# =============================================================================
# STORAGE
# =============================================================================
# Options: local, s3
STORAGE_TYPE=local
MINIO_BUILTIN=false                 # Use built-in MinIO container?

# Local storage path (if STORAGE_TYPE=local)
STORAGE_LOCAL_PATH=./data/media

# S3/MinIO settings (if STORAGE_TYPE=s3, auto-configured if MINIO_BUILTIN=true)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=openwa
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# =============================================================================
# WEBHOOK
# =============================================================================
WEBHOOK_TIMEOUT=10000               # Timeout in milliseconds
WEBHOOK_MAX_RETRIES=3               # Number of retry attempts
WEBHOOK_RETRY_DELAY=5000            # Delay between retries in ms

# =============================================================================
# RATE LIMITING
# =============================================================================
# Disabled automatically when NODE_ENV is not production (set false to enforce locally).
RATE_LIMIT_DISABLED=
# Burst: requests per RATE_LIMIT_SHORT_TTL ms (default 60/sec — inbox loads many parallel calls)
RATE_LIMIT_SHORT_TTL=1000
RATE_LIMIT_SHORT_LIMIT=60
# Sustained: per minute (legacy RATE_LIMIT_TTL seconds + RATE_LIMIT_MAX still work)
RATE_LIMIT_MEDIUM_TTL=60000
RATE_LIMIT_MEDIUM_LIMIT=200
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=200
# Hourly cap
RATE_LIMIT_LONG_TTL=3600000
RATE_LIMIT_LONG_LIMIT=1000

# =============================================================================
# PLUGINS
# =============================================================================
PLUGINS_ENABLED=true                # Enable plugin system
PLUGINS_DIR=./data/plugins          # Plugin directory

# =============================================================================
# SECURITY
# =============================================================================
# First-boot admin key (production). If unset, a secure random key is generated once.
API_MASTER_KEY=

# Dashboard login (JWT) — required in production
# JWT_SECRET=generate-a-long-random-secret
# JWT_ACCESS_EXPIRES_IN=8h
# JWT_REFRESH_EXPIRES_IN=7d
# First admin when users table is empty (one-time bootstrap):
# BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com
# BOOTSTRAP_ADMIN_PASSWORD=choose-a-strong-password
# Production: Swagger off unless ENABLE_SWAGGER=true
# ENABLE_SWAGGER=false
# Production: reject CORS_ORIGINS=* unless explicitly allowed
# ALLOW_OPEN_CORS=false
# CORS_ORIGINS=https://your-dashboard.example.com
# Follow-up auto-send rate limits (per 24h)
# FOLLOWUP_MAX_SENDS_PER_SESSION_PER_DAY=500
# FOLLOWUP_MAX_SENDS_PER_CUSTOMER_PER_DAY=10

# =============================================================================
# AI (configure in dashboard Settings → Integrations → AI)
# =============================================================================
# Optional: auto-seed Dar branch M-Pesa during npm run bootstrap:ai (never overwrites existing active account)
# OPENWA_MPESA_LIPA_NUMBER=123456

# AI_KNOWLEDGE_PATH=./data/ai-knowledge
# AI_KNOWLEDGE_AUTO_INDEX=false
# AI_MEMORY_PATH=./data/ai-memory
# AI_MEMORY_AUTO_INDEX=false          # Skip reindex on API boot
# AI_MEMORY_DREAM_INTERVAL_HOURS=24   # 0 = disabled; promotes recalled facts to MEMORY.md
# Human reply timing (defaults in DB ai_config — Balanced preset; override via Settings → AI Human Behavior)
# AI_HUMAN_TIMING_ENABLED=true
# AI_ACTIVE_CHAT_WINDOW_MS=300000      # 5 min active chat
# AI_WARM_CHAT_WINDOW_MS=1800000       # 30 min warm chat
# Semantic memory search needs DATABASE_TYPE=postgres and built-in Postgres image includes pgvector.

# =============================================================================
# INAUZWA PRODUCT SYNC (optional)
# =============================================================================
# Pull products/variants/IMEI from your INAUZWA Postgres or API into OpenWA CRM catalog.
# Use the same Neon/Postgres URL as INAUZWA server DATABASE_URL (read-only user recommended).
# INAUZWA_DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require
# INAUZWA_BRANCH_ID=your-branch-uuid
# INAUZWA_VENDOR_ID=your-vendor-uuid
# INAUZWA_DB_READ_ONLY=true
# INAUZWA_CURRENCY=TZS
# INAUZWA_AUTO_SYNC_ENABLED=false
# INAUZWA_AUTO_SYNC_INTERVAL_MINUTES=60
# Or sync via INAUZWA HTTP API (sign in on Products page, or set token from INAUZWA login):
# INAUZWA_API_URL=https://your-inauzwa-api.onrender.com/api
# INAUZWA_API_TOKEN=eyJ...
# Supabase auth (same as INAUZWA app login — used when /api/auth/login is not your account store):
# INAUZWA_SUPABASE_URL=https://your-project.supabase.co
# INAUZWA_SUPABASE_ANON_KEY=eyJ...

# =============================================================================
# DEVELOPER SETTINGS
# =============================================================================
ENABLE_SWAGGER=true                 # Enable API documentation at /api/docs
