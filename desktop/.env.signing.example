# Optional — macOS code signing + notarization (local or CI)
# Local: cp desktop/.env.signing.example desktop/.env.signing  then fill values
# Build: npm run dist:mac:signed

# Developer ID Application certificate (base64 .p12) or keychain identity name
# CSC_LINK=
# CSC_KEY_PASSWORD=
# CSC_NAME=Developer ID Application: Your Name (TEAMID)

# Apple notarization (required for Gatekeeper on other Macs)
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=XXXXXXXXXX

# Windows code signing (optional)
# CSC_LINK=base64-encoded-pfx
# CSC_KEY_PASSWORD=

# GitHub Releases publish token (CI uses GITHUB_TOKEN automatically)
# GH_TOKEN=
